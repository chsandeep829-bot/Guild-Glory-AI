rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);
      match /guilds/{guildId} {
        allow read, write: if owns(uid);
        match /{document=**} { allow read, write: if owns(uid); }
      }
      match /chatSessions/{sessionId} {
        allow read, write: if owns(uid);
        match /messages/{messageId} { allow read, write: if owns(uid); }
      }
    }
  }
}